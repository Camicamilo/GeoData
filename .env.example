# Copiar a .env y cambiar TODOS los valores:   cp .env.example .env && chmod 600 .env
# .env NUNCA se versiona (está en .gitignore).
# Generar secretos:   python3 -c "import secrets; print(secrets.token_urlsafe(40))"

DJANGO_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
# Si se restringe, incluir 127.0.0.1 (lo usa el healthcheck). Ej: 1.2.3.4,127.0.0.1
DJANGO_ALLOWED_HOSTS=*
DJANGO_DEBUG=false

POSTGRES_DB=agrolab
POSTGRES_USER=agrolab
POSTGRES_PASSWORD=cambiar-por-otra-clave-larga

# Contraseña de las cuentas demo (jefe, analista, tecnico1..10). Mínimo 10 caracteres.
DEMO_PASSWORD=cambiar-clave-demo

# Regla de negocio y worker
MAX_TRABAJOS_ACTIVOS=3
MAX_UPLOAD_BYTES=2097152
WORKER_DEMORA_SECONDS=2
WORKER_TIMEOUT_SECONDS=120

# IP pública o nombre del servidor (para el certificado)
TLS_CN=agrolab.local
